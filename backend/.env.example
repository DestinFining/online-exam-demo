# Copy this file to backend/.env before running `docker compose up -d`.
# docker compose reads backend/.env automatically when it is started from this
# directory. The file is git-ignored; never commit real credentials.

# Root password for the MySQL container (required — compose refuses to start
# without it). It is only applied when the mysql_data volume is created for the
# first time, so changing it later requires recreating the volume.
DB_PASSWORD=change-me

# Database created on first startup.
MYSQL_DATABASE=online_exam

# --- values the Spring Boot application reads ---
# The application itself does not read .env; export these in your shell, set
# them in your IDE run configuration, or use the "local" profile instead
# (see backend/src/main/resources/application-local.yml).
# DB_URL=jdbc:mysql://localhost:3307/online_exam?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
# DB_USERNAME=root
# DB_PASSWORD=change-me
# JWT_SECRET=            # generate with: openssl rand -base64 48
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# SERVER_PORT=8080
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
